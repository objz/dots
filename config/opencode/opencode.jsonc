{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "file:/home/consti/code/ponytail",
    "github"
  ],
  "model": "localpc/qwen3.8-27b-abliterated-q3k",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 30000
  },
  "providers": {
    "llamacpp": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Qwen Workstation",
